# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Datastores (ports match compose.yaml; 5432/6379 are left free for other local projects)
DATABASE_URL=postgres://advectus:advectus@localhost:5440/advectus
DATABASE_URL_TEST=postgres://advectus:advectus@localhost:5440/advectus_test
REDIS_URL=redis://localhost:6390
QUEUE_CONCURRENCY=2

# Customer record defaults (NetSuite-style subsidiary / currency)
CUSTOMER_SUBSIDIARY=FI
CUSTOMER_CURRENCY=EUR

# PRH YTJ open data
YTJ_BASE_URL=https://avoindata.prh.fi/opendata-ytj-api/v3
YTJ_RATE_PER_SEC=4
YTJ_TIMEOUT_MS=10000

# Pipeline
SYNC_ROW_LIMIT=200
CHUNK_SIZE=1000
ROW_BATCH_SIZE=1000
USABILITY_SCAN_ROWS=200
DATASET_URL=https://avoindata.prh.fi/opendata-ytj-api/v3/all_companies
DATASET_DIR=./data/dumps
DATASET_MIN_RECORDS=400000
DATASET_MAX_AGE_H=24
DATASET_CRON=30 5 * * *
DATASET_TZ=Europe/Helsinki
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=512
