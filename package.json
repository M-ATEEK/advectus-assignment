{
  "name": "advectus-assignment",
  "version": "0.1.0",
  "description": "Business ID enrichment service: enriches CSV lists of Finnish companies from PRH open data (YTJ) and maps them to customer-register records",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "start": "node bin/www.js",
    "dev": "node --watch --env-file-if-exists=.env bin/www.js",
    "worker": "node bin/worker.js",
    "db:migrate": "node bin/db.js migrate",
    "db:rollback": "node bin/db.js migrate:undo",
    "db:status": "node bin/db.js migrate:status",
    "db:seed": "node bin/db.js seed",
    "db:reset": "node bin/db.js reset",
    "lint": "eslint .",
    "test": "NODE_ENV=test LOG_LEVEL=silent node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:watch": "NODE_ENV=test LOG_LEVEL=silent node --test --watch --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bullmq": "^6.4.1",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-validator": "^7.3.2",
    "http-errors": "^2.0.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0"
  }
}
